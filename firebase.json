{
  "hosting": {
    "public": "app/miniguru/build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/for-schools{,/}", "destination": "/consult/#school-t-lab", "type": 301 },
      { "source": "/for-parents{,/}", "destination": "/consult/#home-corner", "type": 301 },
      { "source": "/for-students{,/}", "destination": "/about/", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/site.css",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [ { "key": "Cache-Control", "value": "no-cache" } ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/main.dart.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
